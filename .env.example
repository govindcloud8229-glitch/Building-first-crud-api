# LLM Provider Configuration (OpenAI / OpenRouter / Ollama)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1  # Optional: For OpenRouter or Ollama

# Alternative LLM Provider keys (used by triage & workflow)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=openrouter/free

# Operational Controls
LLM_ENABLED=true
LLM_STUB=0
LLM_TIMEOUT_SECONDS=30.0
LLM_PROMPT_VERSION=triage-v1

# Inngest Configuration
INNGEST_APP_ID=ai-decision-workflow
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV_SERVER_URL=http://localhost:8288

# Application URLs
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
